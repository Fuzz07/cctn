<?xml version="1.0" encoding="utf-8"?>
<!--
    The production site is HTTPS-only, so plain HTTP is refused outright. The
    development servers (emulator host and localhost) are the one exception,
    otherwise `php artisan serve` could not be opened from a debug build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
