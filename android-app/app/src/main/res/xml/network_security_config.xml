<?xml version="1.0" encoding="utf-8"?>
<!--
    Release builds talk to the API over HTTPS and nothing else. There is no
    cleartext exception here at all; the debug source set adds one for local
    development servers, so it can never ship in a release APK.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
