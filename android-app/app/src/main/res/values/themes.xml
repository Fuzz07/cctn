<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        A bare host theme: every colour inside the app comes from the Compose
        theme. This only has to set the window background, so the frame drawn
        before the first composition matches the theme the user ends up seeing.
    -->
    <style name="Theme.CCTNApp" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.CCTNApp.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.CCTNApp</item>
    </style>
</resources>
