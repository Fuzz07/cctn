<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose owns the in-app palette (ui/theme/Color.kt). These few values
        exist for the parts the framework draws before Compose starts: the
        splash screen and the window background behind it.
    -->
    <color name="window_background">#F4F7FB</color>
    <color name="splash_background">#FFFFFF</color>
    <color name="ic_launcher_background">#FFFFFF</color>
</resources>
