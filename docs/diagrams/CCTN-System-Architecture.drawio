<mxfile host="app.diagrams.net" agent="cctn-docs" type="device" version="24.7.5">
  <diagram id="System-Architecture" name="System Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1330" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="System Architecture&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;BCTVI - Bogo Cable Television Inc. · CCTN Online Cable Service Management System · Laravel 9 web application + Android client&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1480" height="56" as="geometry"/></mxCell><mxCell id="n2" value="1   ·   CLIENT LAYER" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#b3b3b3;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="1150" height="225" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Public Website&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;Guest / prospect access&lt;br&gt;· Blade landing page&lt;br&gt;· plan &amp; pricing catalogue&lt;br&gt;· office info, coverage area&lt;br&gt;· chat bubble (POST /chat)&lt;br&gt;· APK download link&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="250" height="160" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Client Web Portal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;Signed-in subscriber&lt;br&gt;· session cookie, guard: client&lt;br&gt;· dashboard &amp; profile&lt;br&gt;· booking + document upload&lt;br&gt;· billing &amp; payment history&lt;br&gt;· notifications&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="340" y="140" width="250" height="160" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Admin Web Console&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;Staff back office&lt;br&gt;· session cookie, guard: admin&lt;br&gt;· appointments &amp; walk-in&lt;br&gt;· clients, services, schedules&lt;br&gt;· billing, payments, sales&lt;br&gt;· equipment, manpower, maintenance&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="610" y="140" width="250" height="160" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Android App  (com.cctn.app)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;Kotlin · Jetpack Compose (BOM 2024.06)&lt;br&gt;· MVVM + Hilt 2.51 DI&lt;br&gt;· Retrofit 2.11 / OkHttp 4.12&lt;br&gt;  + kotlinx.serialization&lt;br&gt;· DataStore session, auth interceptor&lt;br&gt;· deep link cctn:// for Google sign-in&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="880" y="140" width="250" height="160" as="geometry"/></mxCell><mxCell id="n7" value="2   ·   TRANSPORT &amp; EDGE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#b3b3b3;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1150" height="165" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Web channel  -  HTTPS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;routes/web.php · HTML (Blade) responses&lt;br&gt;session cookie + CSRF token on every form&lt;br&gt;multipart uploads for IDs and payment proof&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="395" width="350" height="100" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;API channel  -  HTTPS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;routes/api.php, prefix /api/v1 · JSON in / JSON out&lt;br&gt;Authorization: Bearer [Sanctum token]&lt;br&gt;CORS handled by fruitcake/laravel-cors&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="450" y="395" width="350" height="100" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Web server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;Apache on shared hosting&lt;br&gt;root .htaccess rewrites every request into /public&lt;br&gt;public/index.php front controller boots Laravel&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="830" y="395" width="340" height="100" as="geometry"/></mxCell><mxCell id="n11" value="3   ·   APPLICATION LAYER   -   Laravel 9  (PHP 8)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#b3b3b3;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="40" y="545" width="1150" height="465" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Routing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;routes/web.php - public · client group (auth.client)&lt;br&gt;  · admin group (auth.admin)&lt;br&gt;routes/api.php - /api/v1 public auth + auth:sanctum group&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="590" width="350" height="95" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Middleware &amp; Guards&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;AuthenticateClient (auth.client)&lt;br&gt;AuthenticateAdmin (auth.admin)&lt;br&gt;auth:sanctum · VerifyCsrfToken · TrimStrings · CORS&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="450" y="590" width="350" height="95" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Providers &amp; Config&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;AppServiceProvider · AuthServiceProvider&lt;br&gt;client / admin session guards, sanctum guard&lt;br&gt;config/services.php - Google OAuth credentials&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="830" y="590" width="340" height="95" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Web Controllers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;Home · Auth (login, register, Google OAuth, reset) · Chatbot&lt;br&gt;&lt;br&gt;&lt;b&gt;Client:&lt;/b&gt; Dashboard · Appointment · Billing · Notification&lt;br&gt;&lt;br&gt;&lt;b&gt;Admin:&lt;/b&gt; Auth · Dashboard · Appointment · WalkIn · Client ·&lt;br&gt;Service · Billing · Sales · Schedule · Equipment ·&lt;br&gt;Manpower · Maintenance · Notification&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="705" width="350" height="145" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;API v1 Controllers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;App\Http\Controllers\Api\V1&lt;br&gt;&lt;br&gt;Auth (login, register, google, logout) · Profile&lt;br&gt;Appointment (index, store, destroy, slots)&lt;br&gt;Service · Billing · Maintenance · Notification · Chatbot&lt;br&gt;&lt;br&gt;Stateless - authenticated by Sanctum personal access tokens&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="450" y="705" width="350" height="145" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Chatbot Assistant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;App\Support\Chatbot\Assistant&lt;br&gt;&lt;br&gt;One rule-based engine shared by the website bubble and the&lt;br&gt;mobile chat screen. Matches intents for plans and pricing,&lt;br&gt;office location and hours, coverage area, booking steps,&lt;br&gt;and - for a signed-in client - that client's own bookings&lt;br&gt;and balance.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="830" y="705" width="340" height="145" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Eloquent Models  (ORM)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;Client · Admin · Appointment · Service · TimeSlot&lt;br&gt;BillingAccount · Payment · MaintenanceRequest&lt;br&gt;Equipment · Manpower · Notification · User&lt;br&gt;&lt;br&gt;relationships, casts, query scopes, booking-conflict check,&lt;br&gt;account-number generation&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="870" width="350" height="125" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Response Layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;Blade views (resources/views): layouts, auth, client, admin&lt;br&gt;Bootstrap + vanilla JS, chat widget, printable receipt&lt;br&gt;&lt;br&gt;API Resources (App\Http\Resources) - ServiceResource and&lt;br&gt;JSON envelopes consumed by the Android app&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="450" y="870" width="350" height="125" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Support &amp; Validation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;App\Support\ServiceArea - serviceable barangay / municipality&lt;br&gt;App\Support\InputRules - shared validation rules&lt;br&gt;&lt;br&gt;request validation, upload type and size checks,&lt;br&gt;duplicate-booking and slot-conflict rules&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="830" y="870" width="340" height="125" as="geometry"/></mxCell><mxCell id="n21" value="4   ·   DATA LAYER" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fcfcfc;strokeColor=#b3b3b3;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="1150" height="215" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;MySQL 8  -  application database&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;clients · admins · services · time_slots · appointments&lt;br&gt;billing_accounts · payments · maintenance_requests&lt;br&gt;notifications · equipment · manpower&lt;br&gt;personal_access_tokens · users · migrations&lt;br&gt;&lt;br&gt;schema managed by Laravel migrations (php artisan migrate)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="70" y="1085" width="350" height="150" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;File storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;public/uploads&lt;br&gt;· profile photos · valid IDs · proof of address&lt;br&gt;· proof of billing · payment proofs&lt;br&gt;&lt;br&gt;public/downloads/cctn-app.apk - the distributed Android build&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="450" y="1085" width="350" height="150" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Framework storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;storage/framework - file-driver sessions and cache&lt;br&gt;storage/logs/laravel.log - application log&lt;br&gt;bootstrap/cache - config and route cache&lt;br&gt;&lt;br&gt;(session and cache drivers are file-based, per .env)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="830" y="1085" width="340" height="150" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;MOBILE BUILD &amp; DISTRIBUTION&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;Android Studio + Gradle (Kotlin DSL)&lt;br&gt;→ signed release APK (app v2.x)&lt;br&gt;&lt;br&gt;Published to public/downloads/cctn-app.apk&lt;br&gt;and served by GET /download-apk&lt;br&gt;&lt;br&gt;Google sign-in returns to the app through&lt;br&gt;the cctn:// deep link&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1230" y="95" width="290" height="225" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;DEPLOYMENT / HOSTING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;Hostinger shared hosting (hPanel)&lt;br&gt;PHP 8.1 / 8.2 · Apache · MySQL 8&lt;br&gt;project deployed into public_html&lt;br&gt;composer install · php artisan migrate&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1230" y="350" width="290" height="165" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;EXTERNAL SERVICE&lt;br&gt;Google Identity Platform&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;OAuth 2.0 authorization-code flow&lt;br&gt;&lt;br&gt;accounts.google.com/o/oauth2/v2/auth&lt;br&gt;  consent screen&lt;br&gt;oauth2.googleapis.com/token&lt;br&gt;  code → access token&lt;br&gt;googleapis.com/oauth2/v3/userinfo&lt;br&gt;  verified e-mail, name, photo&lt;br&gt;&lt;br&gt;Called server-side with Guzzle (Http facade);&lt;br&gt;a state parameter guards the callback&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1230" y="545" width="290" height="245" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;SECURITY CONTROLS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;bcrypt password hashing&lt;br&gt;CSRF token on every web form&lt;br&gt;separate client and admin session guards&lt;br&gt;Sanctum bearer tokens for the mobile app&lt;br&gt;OAuth state parameter check&lt;br&gt;unique booking reference per appointment&lt;br&gt;upload type and size validation&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1230" y="820" width="290" height="190" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;STACK SUMMARY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#333333&quot;&gt;&lt;b&gt;Server:&lt;/b&gt; Laravel 9 · PHP 8 · MySQL 8 ·&lt;br&gt;Blade + Bootstrap · Sanctum 2 · Guzzle 7 ·&lt;br&gt;Laravel Mix&lt;br&gt;&lt;br&gt;&lt;b&gt;Mobile:&lt;/b&gt; Kotlin · Compose BOM 2024.06 ·&lt;br&gt;Hilt 2.51 · Retrofit 2.11 · OkHttp 4.12 ·&lt;br&gt;Coil 2.6 · DataStore&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=12;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1230" y="1040" width="290" height="215" as="geometry"/></mxCell><mxCell id="e30" value="HTML" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontSize=10;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e31" value="session request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontSize=10;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e32" value="session request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontSize=10;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="JSON + bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jumpStyle=arc;j