target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e112" value="system events raised by 2.0, 3.0, 4.0 and 5.0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;fontColor=#333333;strokeColor=#9673a6;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#6b4f80;exitX=0.08;exitY=1;exitDx=0;exitDy=0;entryX=0.08;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n55" target="n81"><mxGeometry relative="1" as="geometry"><Array as='points'><mxPoint x="300" y="830"/><mxPoint x="300" y="1010"/></Array></mxGeometry></mxCell><mxCell id="n113" value="Legend" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;dashed=0;spacingLeft=14;fontColor=#1a1a1a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1410" width="1270" height="150" as="geometry"/></mxCell><mxCell id="n114" value="&lt;b&gt;Rectangle&lt;/b&gt; - external entity      &lt;b&gt;Rounded rectangle&lt;/b&gt; - process (numbered n.0)      &lt;b&gt;Open-ended rectangle&lt;/b&gt; - data store (Dn, one MySQL table or the file store)      &lt;b&gt;Arrow&lt;/b&gt; - data flow&lt;br&gt;&lt;b&gt;Dashed amber arrow&lt;/b&gt; - read-only query; the process never writes to that store. &lt;b&gt;Dashed violet arrow&lt;/b&gt; - internal event flow between processes.&lt;br&gt;&lt;br&gt;External entities and data stores are &lt;b&gt;repeated&lt;/b&gt; beside the processes that use them (standard DFD practice) so that no flow lines have to cross the diagram - every copy of D5 is the same appointments store, and every Client box is the same entity.&lt;br&gt;Data stores: D1 clients · D2 admins · D3 services · D4 time_slots · D5 appointments · D6 billing_accounts · D7 payments · D8 maintenance_requests · D9 notifications · D10 equipment · D11 manpower · D12 personal_access_tokens · D13 uploaded documents (public/uploads)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="60" y="1444" width="1230" height="110" as="geometry"/></mxCell>
