        <mxCell id="n1" value="Context Diagram  -  Data Flow Diagram Level 0&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;BCTVI - Bogo Cable Television Inc. · CCTN Online Cable Service Management System&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="56" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;0&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;BCTVI / CCTN&lt;/b&gt;&lt;br&gt;Online Cable Service&lt;br&gt;Management System" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=15;fontColor=#1a1a1a;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="330" width="420" height="220" as="geometry"/></mxCell><mxCell id="n3" value="Website Visitor&lt;br&gt;(Guest / Prospect)" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;dashed=0;spacingLeft=0;fontColor=#1a1a1a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="220" height="90" as="geometry"/></mxCell><mxCell id="n4" value="Client / Subscriber&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;web portal &amp; Android app&lt;/font&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;dashed=0;spacingLeft=0;fontColor=#1a1a1a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="220" height="90" as="geometry"/></mxCell><mxCell id="n5" value="Walk-in Applicant&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;served at the office counter&lt;/font&gt;" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;dashed=0;spacingLeft=0;fontColor=#1a1a