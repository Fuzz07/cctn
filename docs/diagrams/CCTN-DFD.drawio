d4d;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontSize=10;exitX=0.06;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.72;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="admin credentials · approval &amp; status update ·&lt;br&gt;walk-in encoding · billing &amp; payment entry ·&lt;br&gt;plan, slot, equipment &amp; manpower updates ·&lt;br&gt;maintenance follow-up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontSize=10;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.42;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="appointment queue &amp; client records ·&lt;br&gt;billing ledger &amp; sales report ·&lt;br&gt;dashboard counters · unread alerts ·&lt;br&gt;printable receipt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontSize=10;exitX=1;exitY=0.62;exitDx=0;exitDy=0;entryX=0;entryY=0.72;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="authorization request&lt;br&gt;(client_id, scope, redirect_uri) ·&lt;br&gt;token exchange" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontSize=10;exitX=0.88;exitY=0.12;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="authorization code · ID token ·&lt;br&gt;verified profile&lt;br&gt;(email, name, photo)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;fontColor=#333333;strokeColor=#4d4d4d;strokeWidth=1.5;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;fontSize=10;exitX=0;exitY=0.35;exitDx=0;exitDy=0;entryX=0.94;entryY=0.28;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="Legend" style="rounded=0;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=13;fontStyle=1;verticalAlign=top;align=left;dashed=0;spacingLeft=14;fontColor=#1a1a1a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1520" height="96" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Rectangle&lt;/b&gt; - external entity (source or destination of data, outside the system boundary).      &lt;b&gt;Ellipse&lt;/b&gt; - the system as a single process.      &lt;b&gt;Arrow&lt;/b&gt; - a named data flow.&lt;br&gt;The context diagram shows only what crosses the system boundary; no data stores are shown at this level. The walk-in applicant reaches the system through the office counter, where staff encode the application on the applicant's behalf.&lt;br&gt;Notation: Gane-Sarson. Decomposition of process 0 is on the next page (Level 1 DFD)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="60" y="902" width="1480" height="60" as="geometry"/></mxCell>
      </root>
