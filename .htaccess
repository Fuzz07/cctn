# Hostinger / cPanel deployment
#
# Lets the whole Laravel project live inside public_html without changing the
# document root: application folders are blocked and every other request is
# routed into public/, where Laravel's own .htaccess takes over.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Always serve the site over HTTPS. Behind Hostinger's proxy %{HTTPS} is not
    # always set, so the forwarded scheme is checked as well. SSL certificate
    # renewal has to stay reachable over plain HTTP, hence the .well-known skip.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Never serve application internals over HTTP
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|android-app)/ - [F,L]

    # api/ holds the Vercel entry point, which must not be reachable here — but
    # /api/v1/... is the mobile app's route prefix, served by Laravel. Blocking
    # the whole api/ prefix would take the mobile API down with it, so only the
    # physical file is refused.
    RewriteRule ^api/index\.php$ - [F,L]
    RewriteRule ^(\.env.*|\.git.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|webpack\.mix\.js|vercel\.json|DEPLOYMENT\.md|README\.md)$ - [F,L]

    # Send everything else through the front controller in public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Do not list directory contents
Options -Indexes
